# V0.9.3 defaults to the dedicated local OpenClaw agent configured in config/agent.yaml.
# The OpenClaw Responses endpoint must be enabled in the Gateway config.
OPENCLAW_GATEWAY_TOKEN=replace_me

# Optional direct OpenAI provider. Only required when config/agent.yaml uses provider: openai.
OPENAI_API_KEY=replace_me

# Optional deployment override. If set, this overrides config/agent.yaml.
# AGENT_PROVIDER=openclaw

# Optional alternate config path inside the container.
# AGENT_CONFIG_PATH=/app/config/agent.yaml

# Security hardening limits. Defaults below match docker-compose.yml.
# SECURITY_MAX_UPLOAD_BYTES=2147483648
# SECURITY_MAX_PROJECT_BYTES=21474836480
# SECURITY_MAX_PROCESSING_STEPS=100
# SECURITY_SU_TIMEOUT_SECONDS=1800
# SECURITY_IMPORT_TIMEOUT_SECONDS=1800
# SECURITY_MIN_FREE_BYTES=5368709120
# SECURITY_AGENT_REQUESTS_PER_MINUTE=20
