# V0.3.1 defaults to the local OpenClaw provider selected in config/agent.yaml.
# The OpenClaw Responses endpoint must be enabled in the Gateway config.
OPENCLAW_GATEWAY_TOKEN=replace_me

# Optional direct OpenAI provider. Only required when config/agent.yaml uses provider: openai.
OPENAI_API_KEY=replace_me

# Optional deployment override. If set, this overrides config/agent.yaml.
# AGENT_PROVIDER=openclaw

# Optional alternate config path inside the container.
# AGENT_CONFIG_PATH=/app/config/agent.yaml
